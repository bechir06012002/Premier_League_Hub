# Copy this file to app/services/.env and fill in real values.
# Required
MY_EMAIL=your@gmail.com
APP_PASSWORD=your-gmail-app-password
OPENAI_API_KEY=your-openai-api-key

# Optional (defaults shown)
OPENAI_MODEL=gpt-4o-mini

# Auto-injected by Render in production; only needed locally if you don't use POSTGRES_* below
DATABASE_URL=

# Local dev only — used to build the DB URL when DATABASE_URL isn't set
# (matches docker/docker-compose.yml defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional — Webshare proxy credentials for youtube_transcript_api,
# useful if YouTube starts rate-limiting/blocking transcript requests
PROXY_USERNAME=
PROXY_PASSWORD=
